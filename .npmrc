registry=https://registry.npmmirror.com
electron_mirror=https://cdn.npmmirror.com/binaries/electron/
# prebuild-install 默认超时过短，GitHub 一抖就会落到 node-gyp（本机常无 Python）
timeout=120000
allow-build-scripts=sharp,esbuild,electron,better-sqlite3,@lydell/node-pty,bufferutil,utf-8-validate
shamefully-hoist=true
public-hoist-pattern[]=electron
