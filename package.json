{
  "name": "lumii",
  "private": true,
  "description": "灵栖 / Lumii — 本地优先的 AI 桌面伙伴（开源独立版）",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "pnpm --filter ./apps/windows build",
    "dev": "pnpm --filter ./apps/windows dev",
    "dev:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-dev.ps1",
    "dev:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev.ps1",
    "dev:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-dev.ps1 -Force",
    "dev:inspect": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-dev.ps1 -Force -Inspect 5860",
    "dist": "pnpm --filter ./apps/windows package",
    "package:win": "node apps/windows/scripts/package-app.js --platform win",
    "typecheck": "pnpm -r typecheck",
    "check:large-files": "node scripts/check-large-files.mjs",
    "check:large-files:update": "node scripts/check-large-files.mjs --update",
    "check:wiring": "node scripts/check-wiring.mjs --strict",
    "check:wiring:update": "node scripts/check-wiring.mjs --update",
    "check:knip": "pnpm dlx knip@6.38.0 --no-exit-code",
    "verify": "pnpm typecheck && pnpm check:large-files && pnpm check:wiring && pnpm --filter @mtbot/agent-runtime test && pnpm --filter @mtbot/pet-core test && pnpm --filter @mtbot/pet-asset test && pnpm --filter lumii-windows test:all",
    "prepare": "echo skip githooks",
    "dist:win": "pnpm --filter ./apps/windows package:win",
    "dist:linux": "pnpm --filter ./apps/windows package:linux",
    "package:linux": "node apps/windows/scripts/package-app.js --platform linux"
  }
}
