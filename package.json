{
  "name": "lumii",
  "version": "0.1.3",
  "private": true,
  "description": "灵栖 / Lumii — 本地优先的 AI 桌面伙伴（开源独立版）",
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "pnpm --filter ./apps/windows build",
    "dev": "pnpm --filter ./apps/windows dev",
    "dev:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-dev.ps1",
    "dev:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-dev.ps1",
    "dev:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-dev.ps1 -Force",
    "dist": "pnpm --filter ./apps/windows package:win",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-win.ps1",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm typecheck && pnpm --filter lumii-windows test:all",
    "prepare": "echo skip githooks"
  }
}
