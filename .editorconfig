# 仓库级编辑器约定，对应 AGENTS.md「代码编写」一节。
# 仅约束新建/编辑时的默认行为，不做全量重排。
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown 用行尾空格表达换行，不能裁剪
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.{yml,yaml}]
indent_size = 2
