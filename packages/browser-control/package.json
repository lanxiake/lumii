{
  "name": "@mtbot/browser-control",
  "version": "1.0.0",
  "description": "Browser automation and control module for MtBot",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./browser/*": "./src/browser/*.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright-core": "1.58.1"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "peerDependencies": {}
}
