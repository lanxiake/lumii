{
  "name": "@mtbot/pet-asset",
  "version": "0.1.0",
  "description": "宠物素材工具链 CLI：cutout 抠底 / validate 包校验 / install 两段式安装。构建期与 Agent 侧使用，不进运行时。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "pet-asset": "./dist/cli.mjs"
