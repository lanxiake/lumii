  },
  "dependencies": {
    "@mtbot/pet-core": "workspace:*",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
