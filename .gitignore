# Lumii local dev runtime files
.lumii-dev.pid
.lumii-dev.log
# stderr 与内层脚本：start-dev.ps1 生成（后者落成文件用 -File 执行，
# 避开 -Command 传多行脚本的再解析问题），都由脚本每次重建，不入库
.lumii-dev.err.log
.lumii-dev-inner.ps1

# Dependencies
node_modules/

# Build / package outputs
dist/
build/
out/
release/
# package-app.js 的 --output-dir 可产出任意名字的目录（如 release-win-check、
# release-linux-check）。上面的精确条目覆盖不到，用通配兜住，避免几百 MB 的
# 解包产物出现在 git status 里。
release*/
**/win-unpacked.tmp/
**/linux-unpacked.tmp/
coverage/
*.tsbuildinfo
.tts-probe/
# Environment & secrets
.env
.env.*
!.env.example
**/.env
!**/.env.example
**/config/.env.pack
# 生图上游凭据（含真实 API key）。仓库里只保留 draw-config.example.json 作为模板。
# 2026-09-20：此前真实配置被误提交，已取消跟踪；该 key 需在服务商后台轮换。
apps/windows/config/draw-config.json

# Logs & OS junk
*.log
.DS_Store
Thumbs.db
# Windows: redirecting to NUL can create a real file named "nul"
**/nul
nul

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# 本机 agent 配置与临时素材
.claude/settings.local.json
.superpowers/
docs/temp/

# Claude Code 逆向参考（还原源码约 76 MB，可由目录内 tools/ 从 claude.exe 再生），整目录不入库
docs/reference/claude-code-2.1.143/

# Claude Code 的项目级 MCP 配置：里面是**本机绝对路径**（`C:\Users\<你>\...`），
# 还带本机微信库位置与账号 id —— 对别的机器没有任何意义，属于机器专属配置。
# 想共用什么 MCP，请各自 `claude mcp add`，别把它提交上来。
.mcp.json

# Turbo / caches
.turbo/
.cache/
**/node_modules/.cache/

# Git worktrees (local isolated checkouts)
.worktrees/
.worktree/
.claude/worktrees/
.claude/

# Wiki 嵌入模型运行时缓存（约 140MB，不提交 Git）
**/.lumii/models/wiki-embeddings/
apps/windows/resources/wiki-embeddings/Xenova/
apps/windows/resources/wiki-embeddings/.lumii-complete

# 测试素材：真实文档样本（docx/mp4/PDF）体积大，需手动放置，不入库
# 见 docs/test/lumii-cli/CLI-TEST-SPEC.md §6
docs/test/lumii-cli/materials/

# CLI 测试运行时残留
docs/test/**/.cap-session*
# 评测池化中间产物：保留抽屉原文片段，内含内网 IP 与凭证，不入库
# （判断逻辑已固化在 scripts/merge-judgments.mjs，池子本身可随时用
#  scripts/pool-candidates-for-judging.mjs 重建，见评测方法论文档 §4.3）
docs/test/memory-eval/v7-pool.json

# 本机临时产物（agent 备份、pet 精灵图在制目录、test:all 日志转储等）
# 约定前缀 `.tmp-`，目录与文件都忽略，避免 git add -A 误带进仓库
.tmp-*/
.tmp-*

# Python 字节码：`verify/` 与各 MCP 目录下的探针脚本一跑就生成，只有机器相关，不入库
__pycache__/
*.py[cod]

# 探针从本机微信库里扫出来的真实群/联系人标识（`verify/wechat-mcp/regress-*/args/_probe_history.json`
# 里有二十多个真群号）。这类「从用户数据里导出的标识」一律不入库 —— 探针脚本本身照常入库。
verify/**/args/_probe_history.json

# Agent/会话导出与本机临时工作区（2026-10-19 清理时补）
.tmp/
*-this-session-is-being-continued-from-a-previous-c*.txt
# 牌桌/大厅运行时落盘的座位记录（如 human_games.bin.rooms.jsonl），每局都会变
*.rooms.jsonl
