# MtBot Windows客户端环境变量配置
# 复制此文件为 .env 并根据实际情况修改配置值

# ==================== Windows Client Configuration ====================
# API Server 地址 (默认：http://127.0.0.1:3000) 生产环境：https://www.mtbot.top
MTBOT_API_URL=http://127.0.0.1:3000

# Gateway WebSocket 地址 (默认：ws://127.0.0.1:18789)生产环境：wss://www.mtbot.top/ws
MTBOT_GATEWAY_URL=ws://127.0.0.1:18789

# ==================== Internal Gateway Secret ====================
# 用于向 API Server 上报 Agent analytics（X-Gateway-Secret）
# 注意：需与 apps/api-server/.env(.example) 中保持一致
API_SERVER_GATEWAY_SECRET=replace-with-a-strong-shared-secret

# 客户端数据根目录（默认 %USERPROFILE%\.mtbot-client）；兼容别名 MTBOT_DATA_DIR
# MTBOT_CLIENT_DATA_DIR=%USERPROFILE%\.mtbot-client

# ==================== 可选配置 ====================
# 语言设置 (zh-CN 或 en-US)
# MTBOT_LANGUAGE=zh-CN

# 主题设置 (light, dark, auto)
# MTBOT_THEME=auto

# 工作空间目录
# MTBOT_WORKSPACE_DIR=C:/Users/YourName/Documents/MtBot

# 日志级别 (debug, info, warn, error)
# MTBOT_LOG_LEVEL=info

LANGSEARCH_API_KEY=sk-f9dc059e23754a619bd975885220ab3f

# ==================== 搜索引擎配置 ====================
SEARXNG_BASE_URL=https://www.mtbot.top/searxng
SEARXNG_SECRET_KEY=Oc@2026!Sx#SearchSecret