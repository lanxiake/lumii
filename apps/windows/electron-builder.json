{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.lumii.app",
  "productName": "Lumii",
  "copyright": "Copyright © 2026 Lumii",
  "afterPack": "build-resources/after-pack.js",
  "directories": {
    "output": "release",
    "buildResources": "build-resources"
  },
  "files": [
    "!**/*.test.js",
    "!**/*.test.js.map",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.spec.js",
    "!**/*.spec.ts",
    "!**/__tests__/**",
    "!**/__mocks__/**",
    "!**/vitest.config.*",
    "!**/tsconfig*.json",
    "!**/*.tsbuildinfo",
    "!**/.eslintrc*",
    "!**/.editorconfig",
    "!out/**/*.map",
    "out/**/*",
    "package.json",
    "node_modules/playwright-core/**/*",
    "node_modules/msedge-tts/**/*",
    "node_modules/silk-wasm/**/*",
    "node_modules/@xenova/transformers/**/*",
    "node_modules/onnxruntime-node/**/*",
    "node_modules/onnxruntime-common/**/*",
    "!node_modules/lucide-react/**",
    "!node_modules/recharts/**",
    "!node_modules/@uiw/**",
    "!node_modules/pdfjs-dist/**",
    "!node_modules/@xyflow/**",
    "!node_modules/@dagrejs/**",
    "!node_modules/mafs/**",
    "!node_modules/react-markdown/**",
    "!node_modules/rehype-highlight/**",
    "!node_modules/rehype-katex/**",
    "!node_modules/remark-gfm/**",
    "!node_modules/remark-math/**",
    "!node_modules/highlight.js/**",
    "!node_modules/katex/**",
    "!node_modules/clsx/**",
    "!node_modules/computer-modern/**"
  ],
  "electronLanguages": [
    "zh-CN",
    "en-US"
  ],
  "extraResources": [
    {
      "from": "assets",
      "to": "assets",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "config",
      "to": "config",
      "filter": [
        "draw-config.json"
      ]
    },
    {
      "from": "bundled-skills",
      "to": "bundled-skills",
      "filter": [
        "**/*",
        "!**/chrome-profile/**",
        "!**/data/k8s-xhs-series/**",
        "!**/Art/YouTubeThumbnailExamples/**",
        "!**/Art/ThumbnailExamples/**",
        "!**/Art/Examples/**",
        "!**/Art/HeadshotExamples/**"
      ]
    },
    {
      "from": "resources/pet-models",
      "to": "pet-models",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "resources/live2d",
      "to": "live2d",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "resources/app-ui-cli",
      "to": "app-ui-cli",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "resources/user-guides",
      "to": "user-guides",
      "filter": [
        "**/*"
      ]
    }
  ],
  "asar": true,
  "asarUnpack": [
    "**/*.wasm",
    "**/*.node",
    "node_modules/sherpa-onnx-node/**/*",
    "node_modules/onnxruntime-node/bin/napi-v3/*/x64/*",
    "node_modules/@xenova/transformers/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64",
          "ia32"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "assets/icon.ico",
    "executableName": "Lumii",
    "signExecutable": false,
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "requestedExecutionLevel": "asInvoker",
    "verifyUpdateCodeSignature": false,
    "forceCodeSigning": false,
    "files": [
      "!node_modules/@img/sharp-linux-x64/**/*",
      "!node_modules/@img/sharp-libvips-linux-x64/**/*",
      "!node_modules/sherpa-onnx-linux-x64/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**/*"
    ],
    "asarUnpack": [
      "node_modules/@img/sharp-win32-x64/**/*",
      "node_modules/sherpa-onnx-win-x64/**/*",
      "node_modules/sherpa-onnx-win-ia32/**/*"
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "assets/icon.ico",
    "uninstallerIcon": "assets/icon.ico",
    "installerHeaderIcon": "assets/icon.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "灵栖 Lumii",
    "menuCategory": "Lumii",
    "runAfterFinish": true,
    "allowElevation": true,
    "perMachine": false,
    "language": "2052",
    "license": "build-resources/license.txt",
    "installerLanguages": [
      "zh_CN",
      "en_US"
    ],
    "multiLanguageInstaller": true,
    "deleteAppDataOnUninstall": false,
    "displayLanguageSelector": true,
    "include": "build-resources/installer.nsh",
    "warningsAsErrors": false,
    "packElevateHelper": true,
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
  },
  "portable": {
    "artifactName": "${productName}-${version}-portable.${ext}",
    "requestExecutionLevel": "user"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "assets/icon-512.png",
    "executableName": "lumii",
    "category": "Utility",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "!node_modules/@img/sharp-win32-x64/**/*",
      "!node_modules/sherpa-onnx-win-x64/**/*",
      "!node_modules/sherpa-onnx-win-ia32/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v3/win32/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**/*"
    ],
    "asarUnpack": [
      "node_modules/@img/sharp-linux-x64/**/*",
      "node_modules/@img/sharp-libvips-linux-x64/**/*",
      "node_modules/sherpa-onnx-linux-x64/**/*"
    ],
    "desktop": {
      "entry": {
        "Name": "Lumii",
        "Name[zh_CN]": "灵栖 Lumii",
        "Comment": "本地优先的 AI 桌面伙伴",
        "Comment[zh_CN]": "本地优先的 AI 桌面伙伴",
        "Categories": "Utility;",
        "StartupWMClass": "lumii",
        "Keywords": "ai;assistant;agent;"
      }
    }
  },
  "deb": {
    "depends": [
      "libsecret-1-0",
      "libxss1"
    ],
    "recommends": [
      "libayatana-appindicator3-1",
      "fonts-noto-cjk",
      "libnotify4"
    ],
    "afterInstall": "build-resources/deb-postinst.sh",
    "afterRemove": "build-resources/deb-postrm.sh",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "packageName": "lumii"
  },
  "publish": {
    "provider": "github",
    "owner": "lumii",
    "repo": "lumii",
    "releaseType": "release"
  },
  "electronDownload": {
    "mirror": "https://npmmirror.com/mirrors/electron/"
  },
  "buildDependenciesFromSource": false,
  "nodeGypRebuild": false,
  "npmRebuild": false
}
