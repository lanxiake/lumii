{
  "id": "workspace-file-tour",
  "name": "工作区文件巡览",
  "description": "读一份文件、列一次目录、再把它换个名字收尾。演示 postCleanup（无论成败都跑）与 file_* 工具的正确参数。",
  "record": { "enabled": false },
  "preconditions": [
    {
      "id": "pre-read-dir",
      "tool": "list_dir",
      "params": {},
      "hint": "先确认工作区根目录可读——读不到就没必要往下走"
    }
  ],
  "steps": [
    {
      "id": "write",
      "label": "写入演示文件",
      "narration": "先在工作区写一个演示文件。",
      "tool": "file_write",
      "params": { "filePath": "temp/pipeline-demo.txt", "content": "第一行\n第二行\n第三行\n" },
      "holdMs": 800
    },
    {
      "id": "read",
      "label": "读回来",
      "narration": "再把它读回来，确认内容是刚才写的那三行。",
      "tool": "file_read",
      "params": { "filePath": "temp/pipeline-demo.txt" },
      "holdMs": 1200
    },
    {
      "id": "list",
      "label": "列出工作区根目录",
      "narration": "最后看一下工作区根目录里有什么。",
      "tool": "list_dir",
      "params": { "path": "." },
      "holdMs": 1000
    }
  ],
  "postCleanup": [
    {
      "id": "cleanup-rename",
      "tool": "file_move",
      "params": { "source": "temp/pipeline-demo.txt", "destination": "temp/pipeline-demo.done.txt" }
    }
  ]
}
