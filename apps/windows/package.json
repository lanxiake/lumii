{
  "name": "lumii-windows",
  "version": "0.1.1",
  "description": "灵栖 Lumii — 本地优先的 AI 桌面伙伴",
  "main": "out/main/index.js",
  "author": {
    "name": "Lumii"
  },
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/run-dev.cjs",
    "lab": "vite --config pet-lab/vite.config.ts",
    "prebuild": "pnpm typecheck",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "clean": "node scripts/clean-build.js",
    "clean:deep": "rimraf out release node_modules/.cache",
    "package": "node scripts/package-windows.js",
    "package:win": "node scripts/package-windows.js",
    "package:win:x64": "pnpm build && electron-builder --win --x64 --config electron-builder.json",
    "package:win:ia32": "pnpm build && electron-builder --win --ia32 --config electron-builder.json",
    "package:nsis": "pnpm build && electron-builder --win nsis --x64 --ia32 --config electron-builder.json",
    "package:nsis:x64": "pnpm build && electron-builder --win nsis --x64 --config electron-builder.json",
    "package:portable": "pnpm build && node scripts/package-portable.js",
    "package:zip": "pnpm build && electron-builder --win zip --x64 --config electron-builder.json",
    "package:dir": "pnpm build && electron-builder --dir --config electron-builder.json",
    "generate:icon": "node scripts/generate-icon.cjs",
    "prepare:splash": "node scripts/prepare-splash.cjs",
    "import:azur-lane-models": "node scripts/import-azur-lane-pet-models.mjs",
    "import:azur-lane-models:dry": "node scripts/import-azur-lane-pet-models.mjs --dry-run",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/test",
    "test:all": "vitest run",
    "test:watch": "vitest watch src/test",
    "test:ui": "vitest --ui src/test",
    "test:e2e": "playwright test e2e/memory/memory-management.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "rebuild:native": "node node_modules/@electron/rebuild/lib/cli.js --only better-sqlite3,sharp",
    "postinstall": "node node_modules/@electron/rebuild/lib/cli.js --only better-sqlite3,sharp"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@img/sharp-win32-x64": "^0.34.5",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@mtbot/agent-runtime": "workspace:*",
    "@mtbot/browser-control": "workspace:*",
    "@mtbot/pet-core": "workspace:*",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "ajv": "^8.18.0",
    "better-sqlite3": "^12.8.0",
    "bufferutil": "^4.1.0",
    "croner": "^9.1.0",
    "diff": "^8.0.3",
    "dotenv": "^16.3.1",
    "electron-updater": "^6.1.7",
    "epub2": "^3.0.2",
    "esbuild": "^0.28.0",
    "html-to-image": "^1.11.13",
    "iconv-lite": "^0.7.2",
    "isomorphic-git": "^1.38.5",
    "jszip": "^3.10.1",
    "lodash-es": "^4.18.1",
    "mammoth": "^1.11.0",
    "msedge-tts": "^2.0.5",
    "pdf-parse": "^2.4.5",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "playwright-core": "1.58.1",
    "pptx-preview": "^1.0.7",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "sherpa-onnx-node": "^1.11.3",
    "silk-sdk": "^0.2.2",
    "utf-8-validate": "^6.0.6",
    "ws": "^8.16.0",
    "xlsx": "^0.18.5"
  },
  "optionalDependencies": {
    "sherpa-onnx-win-ia32": "^1.13.0",
    "sherpa-onnx-win-x64": "^1.13.0"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/iconv-lite": "^0.0.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.1.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/ws": "^8.5.10",
    "@uiw/react-md-editor": "^4.0.11",
    "@vitejs/plugin-react": "^4.2.1",
    "@xyflow/react": "^12.10.1",
    "clsx": "^2.1.1",
    "electron": "^36.7.3",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.1",
    "highlight.js": "^11.11.1",
    "jsdom": "^28.0.0",
    "katex": "^0.16.45",
    "lucide-react": "^0.441.0",
    "mafs": "^0.21.0",
    "pdfjs-dist": "^5.5.207",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.9"
  }
}
